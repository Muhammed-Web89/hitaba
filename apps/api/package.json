{
  "name": "@hitaba/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nest start --watch --preserveWatchOutput",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test \"src/**/*.spec.ts\"",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "smoke": "tsx scripts/smoke.ts",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:new": "prisma migrate dev",
    "create-admin": "tsx scripts/create-admin.ts",
    "loadtest": "tsx scripts/loadtest.ts",
    "ratelimit": "tsx scripts/ratelimit.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/autocannon": "^7.12.7",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "autocannon": "^8.0.0",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@hitaba/shared": "*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.8",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^11.2.8",
    "@prisma/client": "~6.19.3",
    "dotenv": "^18.0.9",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7",
    "prisma": "~6.19.3"
  }
}
