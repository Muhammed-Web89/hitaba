# ── Genel ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Tarayıcı origin'leri (virgülle). Üretimde yalnızca https.
WEB_ORIGIN=http://localhost:3737
# E-posta ve veli linklerinde kullanılan site adresi. Üretimde https.
PUBLIC_WEB_URL=http://localhost:3737
# Express trust proxy: yerelde "loopback"; Railway/Fly/Render arkasında "1".
TRUST_PROXY=loopback

# ── Veritabanı ────────────────────────────────────────────────────────
# Geliştirme: `npm run db` (PGlite) — tek bağlantı zorunlu.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1&pgbouncer=true
DIRECT_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable
# Neon (üretim):
#   DATABASE_URL=postgresql://USER:PASS@ep-xxx-pooler.REGION.aws.neon.tech/hitaba?sslmode=require&pgbouncer=true&connection_limit=10
#   DIRECT_URL=postgresql://USER:PASS@ep-xxx.REGION.aws.neon.tech/hitaba?sslmode=require

# ── Gizli anahtarlar ──────────────────────────────────────────────────
# Her biri ayrı: node -e 'console.log(require("crypto").randomBytes(48).toString("base64url"))'
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# 32 bayt base64: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
# DİKKAT: değiştirilirse şifreli veriler (tarama cevapları, veli linkleri, mahrem bilgisi) okunamaz.
ENCRYPTION_KEY=

# ── Fotoğraf depolama ─────────────────────────────────────────────────
# Geliştirme: local. Üretim: s3 (Cloudflare R2 önerilir) — bucket herkese açık erişime KAPALI olmalı.
STORAGE_DRIVER=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=auto
# R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── E-posta ───────────────────────────────────────────────────────────
# Geliştirme: log (konsola yazar, /dev/mails). Üretim: resend.
MAIL_DRIVER=log
MAIL_FROM=Hitaba <no-reply@localhost>
RESEND_API_KEY=

# ── Telegram (opsiyonel) ──────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Yalnızca geliştirme: ödeme olmadan connect ekleme. Üretimde açılırsa API başlamaz.
DEV_PAYMENTS=true
