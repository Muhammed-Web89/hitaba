NODE_ENV=development
PORT=4000
# Geliştirme: `npm run db` (PGlite). Üretim: gerçek PostgreSQL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/postgres?sslmode=disable&connection_limit=1&pgbouncer=true
WEB_ORIGIN=http://localhost:3737
PUBLIC_WEB_URL=http://localhost:3737

# `node -e 'console.log(require("crypto").randomBytes(32).toString("base64url"))'`
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
# 32 bayt, base64 — tarama cevapları, veli token'ları, mahrem iletişim bilgisi şifrelemesi
ENCRYPTION_KEY=

STORAGE_DIR=./storage

# Telegram (opsiyonel — yoksa Telegram girişi ve Stars ödemesi kapalı)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Yalnızca geliştirme: ödeme olmadan connect ekleme endpoint'i
DEV_PAYMENTS=true
